    width: 14%;
    height: 82%;
    background-color: #20212A;
},

.panel-misc {
    left: 61%;
    top: 15%;
    width: 14%;
    height: 82%;
    background-color: #20212A;
},

/* PANEL HEADERS */

.panel-title {
    left: 8%;
    top: 4%;
    font-size: 0.72;
    font-weight: bold;
    text-color: #C8B8FF;
},

.empty-label {
    left: 8%;
    top: 16%;
    font-size: 0.55;
    text-color: #777789;
},

