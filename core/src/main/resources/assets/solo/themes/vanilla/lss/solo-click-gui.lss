
/* ========================================
   SHADOW CLIENT — CLICK GUI v0.3
   Dark / Purple Theme
   ======================================== */

/* MAIN WINDOW */

.solo-root {
    width: 82%;
    height: 78%;
    left: 50%;
    top: 50%;
    alignment-x: center;
    alignment-y: center;
    background-color: #171821;
},

/* BRAND */

.brand-name {
    left: 2%;
    top: 2%;
    font-size: 1.2;
    font-weight: bold;
    text-color: #F4F2FA;
},

.brand-suffix {
    left: 13%;
    top: 2%;
    font-size: 1.2;
    font-weight: bold;
    text-color: #A78BFA;
},

.brand-version {
    left: 2.2%;
    top: 8%;
    font-size: 0.55;
    text-color: #85849A;
},

/* ========================================
   CATEGORY PANELS
   ======================================== */

.panel-combat {
    left: 1%;
    top: 15%;
    width: 14%;
    height: 82%;
    background-color: #20212A;
},

.panel-movement {
    left: 16%;
    top: 15%;
    width: 14%;
    height: 82%;
    background-color: #20212A;
},

.panel-player {
    left: 31%;
